# Skopiuj do .env i uzupełnij prawdziwymi danymi. Plik .env nigdy nie trafia do repo.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kgd_group
DB_USER=kgd_group
DB_PASS=

# true tylko lokalnie — na produkcji ukrywa treść błędów przed klientem.
APP_DEBUG=false

# Domena frontendu, która może odpytywać to API z przeglądarki. "*" na czas developmentu.
CORS_ALLOWED_ORIGIN=*

# Panel edycji (admin.php). Domyślnie WYŁĄCZONY, więc panel jest publicznie
# dostępny dla każdego, kto zna adres — ustaw na true, zanim wystawisz panel
# na docelowej domenie. Dane logowania NIE są tutaj — logowanie sprawdza się
# względem tabeli `users` w bazie (login + hash hasła + rola), patrz
# db/005_create_users_table.sql i backend/tools/hash-password.php.
ADMIN_AUTH_ENABLED=false

# Sekret do podpisywania tokenów sesji panelu (HMAC) — losowy ciąg, im dłuższy
# tym lepiej. Wygeneruj przez backend/tools/generate-secret.php (ta sama
# zasada co hash-password.php: wgraj, wywołaj raz, usuń). Bez tego logowanie
# nie zadziała, gdy ADMIN_AUTH_ENABLED=true.
SESSION_SECRET=

# Przycisk "Zbuduj stronę" w panelu — POST /build odpala GitHub Actions
# (workflow_dispatch) bez pushowania commita. GITHUB_TOKEN: fine-grained
# personal access token, uprawnienie tylko "Actions: Read and write",
# ograniczony TYLKO do repozytorium GITHUB_REPO poniżej.
GITHUB_TOKEN=
GITHUB_OWNER=AdamSynowiec
GITHUB_REPO=kgd-group-nextjs
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main
