# Skopiuj do .env i uzupełnij prawdziwymi danymi. Plik .env nigdy nie trafia do repo.
#
# Na serwerze wgrywasz .env RĘCZNIE, RAZ (przez FTP, obok index.php i admin.php).
# CI/CD (.github/workflows/deploy.yml) świadomie go NIE dotyka — nie generuje go
# na nowo przy żadnym pushu i wyklucza go z clean-slate, więc zostaje na serwerze
# bez zmian między deployami. To konfiguracja serwera, nie kod aplikacji.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kgd_group
DB_USER=kgd_group
DB_PASS=

# true tylko lokalnie — na produkcji ukrywa treść błędów przed klientem.
APP_DEBUG=false

# Domena frontendu, która może odpytywać to API z przeglądarki. "*" na czas developmentu.
CORS_ALLOWED_ORIGIN=*

# Panel edycji (admin.php). Domyślnie WYŁĄCZONY, więc panel jest publicznie
# dostępny dla każdego, kto zna adres — ustaw na true, zanim wystawisz panel
# na docelowej domenie. Dane logowania NIE są tutaj — logowanie sprawdza się
# względem tabeli `users` w bazie (login + hash hasła + rola), patrz
# db/005_create_users_table.sql i backend/tools/hash-password.php.
ADMIN_AUTH_ENABLED=false

# Sekret do podpisywania tokenów sesji panelu (HMAC) — losowy ciąg, im dłuższy
# tym lepiej. Wygeneruj przez backend/tools/generate-secret.php (ta sama
# zasada co hash-password.php: wgraj, wywołaj raz, usuń). Bez tego logowanie
# nie zadziała, gdy ADMIN_AUTH_ENABLED=true.
SESSION_SECRET=

# Przycisk "Zbuduj stronę" w panelu — POST /build odpala GitHub Actions
# (workflow_dispatch) bez pushowania commita. GITHUB_TOKEN: fine-grained
# personal access token, uprawnienie tylko "Actions: Read and write",
# ograniczony TYLKO do repozytorium GITHUB_REPO poniżej.
GITHUB_TOKEN=
GITHUB_OWNER=AdamSynowiec
GITHUB_REPO=kgd-group-nextjs
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main

# API dla zewnętrznego systemu (ingest.php, POST /blog/articles). Lista HASHY (sha256)
# tokenów, nie samych tokenów: kid:hash,kid2:hash. Kilka wpisów naraz = rotacja
# bez przestoju. Token + hash wygeneruj przez backend/tools/generate-ingest-token.php.
# Puste = API odrzuca każde żądanie (401).
BLOG_INGEST_TOKENS=

# Formularze strony (POST /contact i /quick-contact w index.php) — wysyłka
# maila przez SMTP. Zmiana serwera pocztowego = zmiana tych wartości, bez kodu.
#   SMTP_SECURE: tls (STARTTLS, zwykle port 587), ssl (zwykle 465) albo none.
#   SMTP_FROM musi być adresem, z którego serwer SMTP pozwala wysyłać
#   (najczęściej = SMTP_USER), inaczej maile trafią do spamu albo zostaną odrzucone.
#   SMTP_VERIFY_TLS=false tylko do testów z serwerem z certyfikatem self-signed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=KGD Group - formularz
SMTP_VERIFY_TLS=true

# Odbiorcy (kilku po przecinku). QUICK_CONTACT_MAIL_TO puste = jak CONTACT_MAIL_TO.
CONTACT_MAIL_TO=
QUICK_CONTACT_MAIL_TO=
# Formularz wysyła też e-mail kontaktowy danej inwestycji ("target") — zostanie
# użyty zamiast CONTACT_MAIL_TO TYLKO, jeśli jest na tej liście (pełne adresy
# albo całe domeny jako "@domena.pl"). Puste = zawsze CONTACT_MAIL_TO.
CONTACT_ALLOWED_TARGETS=

# CRM — po wysłaniu maila z formularza kontaktowego zgłoszenie idzie też na
# webhook CRM (POST JSON: name, email, phone, message, target, domain, utm) —
# tak jak na starym serwerze (modules/ext_mailer). Puste = bez CRM.
# Adres ze starego serwera:
#   https://v2202604354483455263.megasrv.de:8089/api/webhooks/contact-form
CRM_WEBHOOK_URL=
CRM_VERIFY_TLS=true
CRM_TIMEOUT=10
# "target" (e-mail inwestycji) wysyłany do CRM, gdy strona go nie poda — CRM
# rozpoznaje po nim domenę inwestycji. Na starym serwerze: formularz@krj307-2.pl.
CRM_DEFAULT_TARGET=
