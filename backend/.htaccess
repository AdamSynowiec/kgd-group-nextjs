# Dodatkowa warstwa ochronna dla hostingów opartych o Apache (mod_rewrite).
# GŁÓWNA ochrona src/ i .env jest w kodzie PHP — każdy plik w src/ sam
# sprawdza stałą APP_ENTRY (patrz index.php) i nie zależy od tego, czy
# .htaccess w ogóle jest respektowany (na nginx nie jest).
RewriteEngine On
RewriteRule ^(\.env|src/) - [F,L]

# Pliki z panelu (api/uploads): SVG otwarty wprost nie może uruchomić skryptu w domenie strony
# (w <img> i tak nie działa — tam ta polityka nic nie zmienia). nosniff: przeglądarka nie zgaduje typu.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
  </FilesMatch>
</IfModule>

# Część hostingów (CGI/FastCGI) nie przekazuje nagłówka Authorization do PHP.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Ładne adresy API dla zewnętrznego systemu: /api/blog/articles zamiast
# /api/ingest.php?route=/blog/articles (ta druga forma nadal działa, gdy
# hosting ignoruje .htaccess). Kolejne endpointy ingestu dopisuj do listy w nawiasie.
RewriteRule ^(blog/articles|build)/?$ ingest.php?route=/$1 [L,QSA]

# REST API v1 (v1.php): /api/v1/pages -> /api/v1.php?route=/pages. Na nginx (ct8) ta reguła jest
# ignorowana — tam działa forma z ?route= albo odpowiednik w konfiguracji serwera:
#   location ~ ^/api/v1/(.*)$ { rewrite ^/api/v1/(.*)$ /api/v1.php?route=/$1 last; }
RewriteRule ^v1/(.*)$ v1.php?route=/$1 [L,QSA]
