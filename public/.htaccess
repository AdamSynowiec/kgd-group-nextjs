# Najlepszy-wysiłek warstwa dla hostingów opartych o Apache/LiteSpeed
# (mod_expires, mod_deflate, mod_headers). NA TYM HOSTINGU (ct8.pl, nginx)
# .htaccess dla PRZEPISYWANIA URL-i jest ignorowany — patrz backend/.htaccess
# i src/lib/content.ts (dlatego API woła się przez ?route=, nie przez ładny
# URL). mod_expires/mod_deflate/mod_headers to inne moduły niż mod_rewrite —
# mogą być respektowane nawet tam, gdzie rewrite nie działa (zależy od
# konfiguracji hosta) — stąd wciąż warto to mieć jako plik, który nic nie
# psuje, jeśli zostanie zignorowany.
#
# Jeśli po wdrożeniu PageSpeed Insights nadal zgłasza brak długiego cache /
# kompresji dla plików _next/static/... i .css/.js/.woff2 — hosting
# najprawdopodobniej ignoruje cały ten plik (tak jak przewidziano) i trzeba
# szukać opcji "browser caching" / "kompresja" w panelu hostingu albo
# zapytać wsparcie ct8.pl.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Pliki w _next/static/ mają w nazwie hash treści — bezpieczne jest cache'owanie
  # ich "na zawsze" (rok), bo zmiana treści = nowa nazwa pliku, nie nadpisanie starej.
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|avif)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>

  <FilesMatch "\.(mp4|webm|ogg|mp3)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>

  # HTML NIE dostaje długiego cache — build generuje go na nowo przy każdym
  # deployu, a stare zcache'owane HTML-e wskazywałyby na nieistniejące już
  # skróty plików JS/CSS.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------
# Kompresja wstępna (pliki .br/.gz tworzy scripts/compress-static.mjs przy
# buildzie — patrz ten plik po uzasadnienie). Zamiast liczyć na mod_deflate
# w locie (wolniejsze, niższa jakość kompresji, obciąża CPU serwera przy
# każdym żądaniu), serwujemy gotowy, wcześniej skompresowany plik.
#
# Wzorowane na deploy/.htaccess z projektu referencyjnego (viscode), które
# na Apache realnie obniżyło transfer strony z ~220 KiB do ~18 KiB HTML.
# TUTAJ (ct8.pl, nginx) ten blok wymaga mod_rewrite, które — tak jak reszta
# przepisywania adresów w tym pliku — może być ignorowane. Sprawdź nagłówek
# Content-Encoding w devtoolsach po wdrożeniu.
# ---------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Strona główna: / -> index.html.br|gz
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{DOCUMENT_ROOT}/index.html.br -f
  RewriteRule ^$ /index.html.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{DOCUMENT_ROOT}/index.html.gz -f
  RewriteRule ^$ /index.html.gz [L]

  # Podstrony: trailingSlash: true w next.config.ts eksportuje każdą stronę
  # jako katalog z index.html w środku, np. /o-nas/ -> /o-nas/index.html.
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html.br -f
  RewriteRule ^(.+)/$ /$1/index.html.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html.gz -f
  RewriteRule ^(.+)/$ /$1/index.html.gz [L]

  # Zasoby statyczne pod własnym adresem (CSS, JS, SVG, XML, TXT, JSON).
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(?:css|js|svg|xml|txt|json|webmanifest))$ $1.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+\.(?:css|js|svg|xml|txt|json|webmanifest))$ $1.gz [L]
</IfModule>

# Plik .html.br to dla Apache "plik typu .br o nieznanym typie" — trzeba mu
# powiedzieć jedno i drugie: czym treść jest po rozpakowaniu (ForceType)
# i czym została spakowana (Content-Encoding niżej).
<IfModule mod_mime.c>
  RemoveEncoding .br .gz
  RemoveType .br .gz
</IfModule>

<FilesMatch "\.html\.(br|gz)$">
  ForceType text/html
</FilesMatch>
<FilesMatch "\.css\.(br|gz)$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.js\.(br|gz)$">
  ForceType application/javascript
</FilesMatch>
<FilesMatch "\.svg\.(br|gz)$">
  ForceType image/svg+xml
</FilesMatch>
<FilesMatch "\.(xml|json|webmanifest|txt)\.(br|gz)$">
  ForceType text/xml
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    # Bez tego pośrednicy (proxy, CDN) mogliby podać skompresowaną treść
    # klientowi, który jej nie obsługuje.
    Header append Vary Accept-Encoding
    SetEnv no-gzip 1
  </FilesMatch>

  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
    SetEnv no-gzip 1
  </FilesMatch>
</IfModule>
