# Skopiuj do .env.local, jeśli chcesz nadpisać adres backendu (np. lokalny PHP).
# Bez tego pliku next build i tak zadziała — domyślnie liczy adres jako
# `${seoDefaults.metadataBase}/api` z src/data/site.json.

API_BASE_URL=https://testkgddemo.ct8.pl/api

# Adres backendu widziany przez PRZEGLĄDARKĘ (panel /admin robi zapytania
# w czasie rzeczywistym, nie w czasie builda) — musi mieć prefiks NEXT_PUBLIC_,
# żeby Next.js w ogóle wpisał go do paczki klienckiej. Domyślnie (bez tego)
# panel używa względnej ścieżki "/api" — działa automatycznie, bo backend
# i strona żyją pod tą samą domeną. Ustaw tylko, gdy backend jest gdzie indziej.
# NEXT_PUBLIC_API_BASE_URL=https://testkgddemo.ct8.pl/api

# Link "sprawdź postęp" pod przyciskiem "Zbuduj stronę" w panelu — sam adres
# repo na GitHubie, bez /actions na końcu. Ma domyślną wartość w kodzie,
# ustaw tylko, jeśli repo się kiedyś przeniesie/przemianuje.
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/AdamSynowiec/kgd-group-nextjs
